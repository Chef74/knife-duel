local ESP_COLOR_HIDDEN = Color3.fromRGB(255, 0, 0)   -- behind a wall
local ESP_COLOR_VISIBLE = Color3.fromRGB(0, 255, 0)  -- clear line of sight
 
local function findHumanoid(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end
 
local function createESPFor(player)
    if espObjects[player] then return end
    if player == LocalPlayer then return end
 
    local entry = {}
    espObjects[player] = entry
 
    local function attach(character)
        if not character then return end
        local rootPart = character:WaitForChild("HumanoidRootPart", 5)
        local humanoid = findHumanoid(character) or character:WaitForChild("Humanoid", 5)
        if not rootPart then return end
 
        -- Red see-through-walls outline
        local highlight = Instance.new("Highlight")
        highlight.Name = "OwnerESP_Highlight"
        highlight.FillTransparency = 1 -- outline only, no fill
        highlight.OutlineColor = ESP_COLOR_HIDDEN
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop -- see through walls
        highlight.Adornee = character
        highlight.Parent = character
        entry.highlight = highlight
 
        -- Name + HP billboard
        local billboard = Instance.new("BillboardGui")
        billboard.Name = "OwnerESP_Billboard"
        billboard.Adornee = rootPart
        billboard.Size = UDim2.new(0, 160, 0, 44)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = character
 
        billboard.Size = UDim2.new(0, 160, 0, 58)
 
        local nameLabel = Instance.new("TextLabel")
        nameLabel.Size = UDim2.new(1, 0, 0, 16)
        nameLabel.Position = UDim2.new(0, 0, 0, 0)
        nameLabel.BackgroundTransparency = 1
        nameLabel.TextColor3 = Color3.new(1, 1, 1)
        nameLabel.TextStrokeTransparency = 0
        nameLabel.Font = Enum.Font.GothamBold
        nameLabel.TextScaled = true
        nameLabel.Text = player.Name
        nameLabel.Parent = billboard
 
        local distanceLabel = Instance.new("TextLabel")
        distanceLabel.Name = "DistanceLabel"
        distanceLabel.Size = UDim2.new(1, 0, 0, 14)
        distanceLabel.Position = UDim2.new(0, 0, 0, 16)
        distanceLabel.BackgroundTransparency = 1
        distanceLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
        distanceLabel.TextStrokeTransparency = 0.3
        distanceLabel.Font = Enum.Font.Gotham
        distanceLabel.TextScaled = true
        distanceLabel.Text = ""
        distanceLabel.Parent = billboard
 
        local hpBackground = Instance.new("Frame")
        hpBackground.Size = UDim2.new(1, 0, 0, 10)
        hpBackground.Position = UDim2.new(0, 0, 0, 32)
        hpBackground.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        hpBackground.BorderSizePixel = 0
        hpBackground.Parent = billboard
 
        local hpBar = Instance.new("Frame")
        hpBar.Name = "HPBar"
        hpBar.Size = UDim2.new(1, 0, 1, 0)
        hpBar.BackgroundColor3 = Color3.fromRGB(0, 200, 0)
        hpBar.BorderSizePixel = 0
        hpBar.Parent = hpBackground
 
        local hpText = Instance.new("TextLabel")
        hpText.Size = UDim2.new(1, 0, 1, 0)
        hpText.BackgroundTransparency = 1
        hpText.TextColor3 = Color3.new(1, 1, 1)
        hpText.TextStrokeTransparency = 0.3
        hpText.Font = Enum.Font.Gotham
        hpText.TextScaled = true
        hpText.Text = ""
        hpText.Parent = hpBackground
 
        entry.gui = billboard
        entry.rootPart = rootPart
        entry.head = character:FindFirstChild("Head")
        entry.character = character
        entry.distanceLabel = distanceLabel
 
        local function updateHP()
            if humanoid then
                local hp = math.max(humanoid.Health, 0)
                local maxHp = math.max(humanoid.MaxHealth, 1)
                local pct = hp / maxHp
                hpBar.Size = UDim2.new(pct, 0, 1, 0)
                hpBar.BackgroundColor3 = Color3.fromRGB(255 * (1 - pct), 200 * pct, 0)
                hpText.Text = string.format("%d / %d", math.floor(hp), math.floor(maxHp))
            end
        end
        updateHP()
 
        if humanoid then
            entry.conn = humanoid.HealthChanged:Connect(updateHP)
        end
    end
 
    if player.Character then
        attach(player.Character)
    end
    entry.charAddedConn = player.CharacterAdded:Connect(attach)
end
 
local function destroyESPFor(player)
    local entry = espObjects[player]
    if not entry then return end
    if entry.highlight then entry.highlight:Destroy() end
    if entry.gui then entry.gui:Destroy() end
    if entry.conn then entry.conn:Disconnect() end
    if entry.charAddedConn then entry.charAddedConn:Disconnect() end
    espObjects[player] = nil
end
 
local function enableESP()
    espEnabled = true
    for _, player in ipairs(Players:GetPlayers()) do
        createESPFor(player)
    end
end
 
local function disableESP()
    espEnabled = false
    for player in pairs(espObjects) do
        destroyESPFor(player)
    end
end
 
-- ============ DISTANCE + VISIBILITY UPDATES ============
local distanceHeartbeatConn
 
local function isVisible(myRoot, entry)
    local targetPart = entry.head or entry.rootPart
    if not targetPart then return false end
 
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { LocalPlayer.Character, entry.character }
    rayParams.IgnoreWater = true
 
    local origin = myRoot.Position
    local direction = targetPart.Position - origin
    local result = Workspace:Raycast(origin, direction, rayParams)
 
    -- No hit before reaching the target = clear line of sight
    return result == nil
end
 
local function startDistanceLoop()
    if distanceHeartbeatConn then return end
    distanceHeartbeatConn = RunService.Heartbeat:Connect(function()
        local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not myRoot then return end
 
        for player, entry in pairs(espObjects) do
            if entry.rootPart and entry.rootPart.Parent and entry.distanceLabel then
                local dist = (entry.rootPart.Position - myRoot.Position).Magnitude
                entry.distanceLabel.Text = string.format("%d studs", math.floor(dist))
            end
 
            if entry.highlight then
                if isVisible(myRoot, entry) then
                    entry.highlight.OutlineColor = ESP_COLOR_VISIBLE
                else
                    entry.highlight.OutlineColor = ESP_COLOR_HIDDEN
                end
            end
        end
    end)
end
 
local function stopDistanceLoop()
    if distanceHeartbeatConn then
        distanceHeartbeatConn:Disconnect()
        distanceHeartbeatConn = nil
    end
end
 
Players.PlayerAdded:Connect(function(player)
    if espEnabled then
        createESPFor(player)
    end
end)
 
Players.PlayerRemoving:Connect(function(player)
    destroyESPFor(player)
end)
 
