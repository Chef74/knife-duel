-- ========== CONFIG SYSTEM ==========
local function SaveConfig(name)
    EnsureFolder()
    name = name or CONFIG_FILE
    local path = CONFIG_FOLDER .. "/" .. name
    local ok, err = pcall(function()
        writefile(path, HttpService:JSONEncode(Config))
    end)
    return ok
end

local function LoadConfig(name)
    EnsureFolder()
    name = name or CONFIG_FILE
    local path = CONFIG_FOLDER .. "/" .. name
    if not isfile(path) then return false end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile(path))
    end)
    if ok and type(data) == "table" then
        for k, v in pairs(data) do
            if Config[k] ~= nil then
                Config[k] = v
            end
        end
        -- Re-apply live states
        ToggleKillAura(Config.KillAura)
        ToggleAimbot(Config.Aimbot)
        ApplySpeed()
        ToggleFly(Config.Fly)
        ToggleFullbright(Config.Fullbright)
        return true
    end
    return false
end

local function ResetConfig()
    for k, v in pairs(DefaultConfig) do
        Config[k] = v
    end
    ToggleKillAura(false)
    ToggleAimbot(false)
    ToggleFly(false)
    ToggleFullbright(false)
    ClearESP()
end

