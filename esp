-- ========== HARDENED AC EVASION LAYER ==========
-- Multi-hook surface + property spoof + kick interception + timing jitter
-- Designed to reduce common client-side signature hits (namecall patterns, WalkSpeed flags, Kick calls, Drawing spam)

local mt = getrawmetatable(game)
local oldNamecall, oldIndex, oldNewIndex
setreadonly(mt, false)

local protected = {
    WalkSpeed = true,
    JumpPower = true,
    Health = true,
    MaxHealth = true,
}

local spoofedValues = {
    WalkSpeed = 16,
    JumpPower = 50,
}

local function jitter()
    if Config.AC_TimingJitter then
        task.wait(math.random(8, 22) / 1000)
    end
end

-- Namecall hook (silent aim + remote filter + anti-kick)
oldNamecall = mt.__namecall
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if Config.AC_KickBlock and (method == "Kick" or method == "kick") then
        return
    end

    if Config.AC_Namecall and method == "FireServer" then
        local name = tostring(self):lower()
        if name:find("throw") or name:find("knife") or name:find("combat") or name:find("attack") or name:find("swing") or name:find("slash") then
            if Config.SilentAim then
                local target = GetClosestPlayer(Config.SilentAimFOV, Config.SilentAimHitPart)
                if target and target.Character then
                    local hitPart = target.Character:FindFirstChild(Config.SilentAimHitPart)
                        or target.Character:FindFirstChild("HumanoidRootPart")
                    if hitPart then
                        for i, v in ipairs(args) do
                            if typeof(v) == "Vector3" then
                                args[i] = hitPart.Position + Vector3.new(0, math.random(-2, 2) / 10, 0)
                            elseif typeof(v) == "CFrame" then
                                args[i] = CFrame.new(v.Position, hitPart.Position)
                            end
                        end
                    end
                end
            end
            jitter()
        end
    end

    return oldNamecall(self, unpack(args))
end)

-- __index spoof (hide real WalkSpeed / JumpPower from common scanners)
oldIndex = mt.__index
mt.__index = newcclosure(function(self, key)
    if Config.AC_IndexSpoof and typeof(self) == "Instance" then
        if self:IsA("Humanoid") and protected[key] then
            return spoofedValues[key] or oldIndex(self, key)
        end
    end
    return oldIndex(self, key)
end)

-- __newindex guard
oldNewIndex = mt.__newindex
mt.__newindex = newcclosure(function(self, key, value)
    if Config.AC_IndexSpoof and typeof(self) == "Instance" then
        if self:IsA("Humanoid") and protected[key] then
            if key == "WalkSpeed" and Config.Speed then
                spoofedValues.WalkSpeed = 16
                return oldNewIndex(self, key, value)
            end
            if key == "JumpPower" and Config.Jump then
                spoofedValues.JumpPower = 50
                return oldNewIndex(self, key, value)
            end
        end
    end
    return oldNewIndex(self, key, value)
end)

setreadonly(mt, true)

-- Safe Kick block on Player
pcall(function()
