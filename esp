-- GUN MODS LOOP (No Spread/Recoil/Inf Ammo/Rapid)
local GunConn
function ToggleGunMods(Enabled)
    if GunConn then GunConn:Disconnect() end
    if Enabled then
        GunConn = RunService.Heartbeat:Connect(function()
            for _, Tool in pairs(LocalPlayer.Backpack:GetChildren()) do
                if Tool:IsA("Tool") then
                    pcall(function()
                        local Settings = Tool:FindFirstChild("GunSettings") or Tool:FindFirstChildOfClass("Folder")
                        if Settings then
                            local Spread = Settings:FindFirstChild("SpreadAmount")
                            local Recoil = Settings:FindFirstChild("Recoil")
                            local Ammo = Tool:FindFirstChild("Ammo")
                            if getgenv().GunMods.NoSpread and Spread then Spread.Value = 0 end
                            if getgenv().GunMods.NoRecoil and Recoil then Recoil.Value = 0 end
                            if getgenv().GunMods.InfAmmo and Ammo then Ammo.Value = math.huge end
                        end
                        -- Rapid Fire (lower delay)
                        local FireRate = Tool:FindFirstChild("FireRate")
                        if FireRate then FireRate.Value = 0.01 end
                    end)
                end
            end
            -- Equipped too
            local Equipped = LocalPlayer.Character:FindFirstChildOfClass("Tool")
            if Equipped then
                -- Same mods
                pcall(function()
                    local Settings = Equipped:FindFirstChild("GunSettings")
                    if Settings then
                        local Spread = Settings:FindFirstChild("SpreadAmount")
                        local Recoil = Settings:FindFirstChild("Recoil")
                        local Ammo = Equipped:FindFirstChild("Ammo")
                        if getgenv().GunMods.NoSpread and Spread then Spread.Value = 0 end
                        if getgenv().GunMods.NoRecoil and Recoil then Recoil.Value = 0 end
                        if getgenv().GunMods.InfAmmo and Ammo then Ammo.Value = math.huge end
                    end
                end)
            end
        end)
    end
end

-- ESP (Boxes + Tracers)
function ToggleESP(Enabled)
    for _, Box in pairs(ESPBoxes) do Box:Remove() end
    for _, Tracer in pairs(Tracers) do Tracer:Remove() end
    ESPBoxes = {}
    Tracers = {}
    if Enabled then
        RunService.RenderStepped:Connect(function()
            for _, Player in pairs(Players:GetPlayers()) do
                if Player ~= LocalPlayer and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
                    local Root = Player.Character.HumanoidRootPart
                    local Vector, OnScreen = Camera:WorldToViewportPoint(Root.Position)
                    if OnScreen then
                        -- Box
                        local Box = DrawingLib:CreateQuad()
                        Box.Color = Color3.new(1,0,0)
                        Box.Thickness = 2
                        Box.Transparency = 0.8
                        -- Size calc (simple)
                        Box.PointA = Vector2.new(Vector.X - 1000, Vector.Y - 2000)
                        Box.PointB = Vector2.new(Vector.X + 1000, Vector.Y - 2000)
                        Box.PointC = Vector2.new(Vector.X + 1000, Vector.Y + 2000)
                        Box.PointD = Vector2.new(Vector.X - 1000, Vector.Y + 2000)
                        Box.Visible = true
                        ESPBoxes[Player] = Box
                        
                        if getgenv().Visuals.Tracers then
                            local Tracer = DrawingLib:CreateLine()
                            Tracer.From = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
                            Tracer.To = Vector2.new(Vector.X, Vector.Y)
                            Tracer.Color = Color3.new(0,1,0)
                            Tracer.Thickness = 2
                            Tracer.Transparency = 0.8
                            Tracers[Player] = Tracer
                        end
                    end
                end
            end
        end)
    end
end

