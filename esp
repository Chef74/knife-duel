local function GetClosestPlayer(fov, partName)
    local closest, closestDist = nil, fov or math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            local part = plr.Character:FindFirstChild(partName or "Head") or plr.Character:FindFirstChild("HumanoidRootPart")
            if hum and hum.Health > 0 and part then
                local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local dist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
                    if dist < closestDist then
                        closestDist = dist
                        closest = plr
                    end
                end
            end
        end
    end
    return closest, closestDist
end

local function IsAlive(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end

-- Kill Aura
local KillAuraConnection
local function ToggleKillAura(state)
    if KillAuraConnection then
        KillAuraConnection:Disconnect()
        KillAuraConnection = nil
    end
    if not state then return end

    KillAuraConnection = RunService.Heartbeat:Connect(function()
        if not Config.KillAura then return end
        local char = LocalPlayer.Character
        if not char or not IsAlive(char) then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then return end

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and IsAlive(plr.Character) then
                local tRoot = plr.Character:FindFirstChild("HumanoidRootPart")
                if tRoot and (root.Position - tRoot.Position).Magnitude <= Config.KillAuraRange then
                    jitter()
                    pcall(function()
                        local tool = char:FindFirstChildOfClass("Tool")
                        if tool then
                            for _, r in ipairs(tool:GetDescendants()) do
                                if r:IsA("RemoteEvent") or r:IsA("RemoteFunction") then
                                    pcall(function() r:FireServer("Swing") end)
                                    pcall(function() r:FireServer() end)
                                end
                            end
                        end
                        mouse1click()
                    end)
                end
            end
        end
    end)
end

-- Aimbot
local AimbotConnection
local function ToggleAimbot(state)
    if AimbotConnection then
        AimbotConnection:Disconnect()
        AimbotConnection = nil
    end
    if not state then return end

    AimbotConnection = RunService.RenderStepped:Connect(function()
        if not Config.Aimbot then return end
        local target = GetClosestPlayer(Config.SilentAimFOV, Config.SilentAimHitPart)
        if target and target.Character then
            local part = target.Character:FindFirstChild(Config.SilentAimHitPart) or target.Character:FindFirstChild("HumanoidRootPart")
            if part then
                local current = Camera.CFrame
                local goal = CFrame.new(current.Position, part.Position)
                Camera.CFrame = current:Lerp(goal, Config.AimbotSmooth)
            end
        end
    end)
end

-- ESP
local ESPObjects = {}
local function ClearESP()
    for _, data in pairs(ESPObjects) do
        if data.Box then data.Box:Remove() end
        if data.Name then data.Name:Remove() end
        if data.Tracer then data.Tracer:Remove() end
        if data.Highlight then data.Highlight:Destroy() end
    end
    table.clear(ESPObjects)
end

local function CreateESP(plr)
    if ESPObjects[plr] then return end
    local data = {
        Box = Drawing.new("Square"),
        Name = Drawing.new("Text"),
        Tracer = Drawing.new("Line"),
        Highlight = Instance.new("Highlight"),
    }
    data.Box.Thickness = 1
    data.Box.Filled = false
    data.Box.Color = Color3.fromRGB(0, 255, 110)
    data.Box.Visible = false

    data.Name.Size = 13
    data.Name.Center = true
    data.Name.Outline = true
    data.Name.Color = Color3.fromRGB(255, 255, 255)
    data.Name.Visible = false

    data.Tracer.Thickness = 1
    data.Tracer.Color = Color3.fromRGB(0, 190, 255)
    data.Tracer.Visible = false

    data.Highlight.FillColor = Color3.fromRGB(0, 255, 90)
    data.Highlight.OutlineColor = Color3.fromRGB(0, 0, 0)
    data.Highlight.FillTransparency = 0.55
    data.Highlight.OutlineTransparency = 0
    data.Highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    data.Highlight.Enabled = false

    ESPObjects[plr] = data
end

local function UpdateESP()
    if not (Config.ESP or Config.Tracers or Config.Chams) then
        ClearESP()
        return
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            CreateESP(plr)
            local data = ESPObjects[plr]
            local char = plr.Character
            if char and IsAlive(char) then
                local root = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                if root and head then
                    local pos, onScreen = Camera:WorldToViewportPoint(root.Position)
                    local headPos = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                    local legPos = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

                    if onScreen then
                        local height = math.abs(headPos.Y - legPos.Y)
                        local width = height * 0.55

                        data.Box.Size = Vector2.new(width, height)
                        data.Box.Position = Vector2.new(pos.X - width / 2, pos.Y - height / 2)
                        data.Box.Visible = Config.ESP

                        data.Name.Text = plr.Name
                        data.Name.Position = Vector2.new(pos.X, headPos.Y - 15)
                        data.Name.Visible = Config.ESP

                        data.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        data.Tracer.To = Vector2.new(pos.X, pos.Y)
                        data.Tracer.Visible = Config.Tracers

                        if Config.Chams then
                            data.Highlight.Adornee = char
                            data.Highlight.Parent = ESPFolder
                            data.Highlight.Enabled = true
                        else
                            data.Highlight.Enabled = false
                        end
                    else
                        data.Box.Visible = false
                        data.Name.Visible = false
                        data.Tracer.Visible = false
                        data.Highlight.Enabled = false
                    end
                end
            else
                data.Box.Visible = false
                data.Name.Visible = false
                data.Tracer.Visible = false
                data.Highlight.Enabled = false
            end
        end
    end
end

